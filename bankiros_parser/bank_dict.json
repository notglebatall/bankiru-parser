{"\u0413\u0430\u0437\u043f\u0440\u043e\u043c\u0431\u0430\u043d\u043a\u0430": "\u0413\u0430\u0437\u043f\u0440\u043e\u043c\u0431\u0430\u043d\u043a", "\u0421\u0432\u043e\u0435\u0433\u043e \u0411\u0430\u043d\u043a\u0430": "\u0421\u0432\u043e\u0439 \u0411\u0430\u043d\u043a", "\u041c\u0422\u0421 \u0411\u0430\u043d\u043a\u0430": "\u041c\u0422\u0421 \u0411\u0430\u043d\u043a", "\u041f\u0440\u043e\u043c\u0441\u0432\u044f\u0437\u044c\u0431\u0430\u043d\u043a\u0430": "\u041f\u0440\u043e\u043c\u0441\u0432\u044f\u0437\u044c\u0431\u0430\u043d\u043a", "\u0410\u0431\u0441\u043e\u043b\u044e\u0442 \u0411\u0430\u043d\u043a\u0430": "\u0410\u0431\u0441\u043e\u043b\u044e\u0442 \u0411\u0430\u043d\u043a", "\u0410\u0437\u0438\u0430\u0442\u0441\u043a\u043e-\u0422\u0438\u0445\u043e\u043e\u043a\u0435\u0430\u043d\u0441\u043a\u043e\u0433\u043e \u0411\u0430\u043d\u043a\u0430": "\u0410\u0437\u0438\u0430\u0442\u0441\u043a\u043e-\u0422\u0438\u0445\u043e\u043e\u043a\u0435\u0430\u043d\u0441\u043a\u0438\u0439 \u0411\u0430\u043d\u043a", "\u0410\u043b\u043c\u0430\u0437\u044d\u0440\u0433\u0438\u044d\u043d\u0431\u0430\u043d\u043a\u0430": "\u0410\u043b\u043c\u0430\u0437\u044d\u0440\u0433\u0438\u044d\u043d\u0431\u0430\u043d\u043a", "\u0410\u043b\u044c\u0444\u0430-\u0411\u0430\u043d\u043a\u0430": "\u0410\u043b\u044c\u0444\u0430-\u0411\u0430\u043d\u043a", "\u0411\u0416\u0424 \u0411\u0430\u043d\u043a\u0430": "\u0411\u0416\u0424 \u0411\u0430\u043d\u043a", "\u0411\u044b\u0441\u0442\u0440\u043e\u0411\u0430\u043d\u043a\u0430": "\u0411\u044b\u0441\u0442\u0440\u043e\u0411\u0430\u043d\u043a", "\u0412\u0441\u0435\u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0433\u043e \u0411\u0430\u043d\u043a\u0430 \u0420\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0420\u0435\u0433\u0438\u043e\u043d\u043e\u0432": "\u0412\u0411\u0420\u0420", "\u0418\u043d\u0431\u0430\u043d\u043a\u0430": "\u0418\u043d\u0431\u0430\u043d\u043a", "\u0418\u043d\u0432\u0435\u0441\u0442\u0442\u043e\u0440\u0433\u0431\u0430\u043d\u043a\u0430": "\u0418\u0